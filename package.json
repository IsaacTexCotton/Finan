    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
